// given a year, return the century it is in.
// e.g 1 to 100 (included) -> 1
// 101 to 200 (include) -> 2

// solving idea:
// year / 100 ? division depends on how many digits we got on year.
// 

let year: number = 1805;

console.log(Math.ceil(year / (year.toString().length === 1 ? 10 : 100))); // ceil to always round to the next number.

// Next exercice: check palindrome?? (if string reads the same backwards and forwards)
function isPalindrome(str: string): boolean {

	let last: number = str.length - 1;
	let begin: number = 0;

	while (begin != last) {
		if (str[begin] != str[last]) return false;
		begin++;
		last++;
	}
	return true;
}


